@@ -0,0 +1,28 @@
+"""MimicGen task specification for BARX mug flipping."""
+
+from mimicgen.configs.config import MG_Config
+
+
+class FlipMugUprightConfig(MG_Config):
+    NAME = "FlipMugUpright"
+    TYPE = "robosuite"
+
+    def task_config(self):
+        common = {
+            "object_ref": "obj",
+            "action_noise": 0.05,
+            "num_interpolation_steps": 5,
+            "selection_strategy": "nearest_neighbor_interpolation",
+            "selection_strategy_kwargs": {"nn_k": 5},
+        }
+        self.task.task_spec.stage_1 = {
+            **common,
+            "subtask_term_signal": "stage_contact_obj",
+            "subtask_term_offset_range": (10, 20),
+        }
+        self.task.task_spec.stage_2 = {
+            **common,
+            "subtask_term_signal": None,
+            "subtask_term_offset_range": None,
+        }
+        self.task.task_spec.do_not_lock_keys()
diff --git a/mimicgen/env_interfaces/robocasa/single_stage/mg_mug.py b/mimicgen/env_interfaces/robocasa/single_stage/mg_mug.py
