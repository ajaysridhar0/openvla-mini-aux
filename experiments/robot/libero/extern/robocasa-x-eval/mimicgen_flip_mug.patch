index 0000000..13f3739
--- /dev/null
+++ b/mimicgen/env_interfaces/robocasa/single_stage/mg_mug.py
@@ -0,0 +1,20 @@
+"""MimicGen environment interface for BARX mug flipping."""
+
+from mimicgen.env_interfaces.robosuite import RobosuiteInterface
+
+
+class MG_FlipMugUpright(RobosuiteInterface):
+    def get_object_poses(self):
+        return {
+            "obj": self.get_object_pose(
+                obj_name=self.env.objects["obj"].root_body,
+                obj_type="body",
+            )
+        }
+
+    def get_subtask_term_signals(self):
+        contact = self.env.check_contact(
+            self.env.robots[0].gripper["right"],
+            self.env.objects["obj"],
+        )
+        return {"stage_contact_obj": int(contact), "stage_place_obj": int(self.env._check_success())}
